# Copy to .env and fill in. .env is gitignored; this file is checked in.

# API on the host -> Dockerised MySQL (compose publishes container 3306 on host 3307).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=card_analytics
MYSQL_POOL_SIZE=5

