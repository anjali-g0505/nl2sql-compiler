# Copy to .env and fill in. .env is gitignored; this file is checked in.

# API on the host -> Dockerised MySQL (compose publishes container 3306 on host 3307).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
# The app's account: read-only (SELECT on card_analytics), created by
# docker/mysql/03_app_user.sh. Use a long random password, e.g.
#   python -c "import secrets; print(secrets.token_hex(16))"
MYSQL_USER=intentql_ro
MYSQL_PASSWORD=change_me
# MySQL admin account: used only by the mysql container, never by the app
MYSQL_ROOT_PASSWORD=change_me_too
MYSQL_DATABASE=card_analytics
MYSQL_POOL_SIZE=5

# API as a container in the same compose project:
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# NL -> DSL translator on Groq (https://console.groq.com/keys). Leave the key empty to
# run without it: questions then return 503, and DSL can still be sent directly.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Where parked clarifications wait. Leave empty to keep them in the app's memory,
# which is correct only for a single worker; set it to run more than one.
# With docker compose, Redis requires REDIS_PASSWORD (the app container builds its own
# URL from it); this URL is for running the API outside Docker.
REDIS_PASSWORD=change_me_as_well
REDIS_URL=redis://:change_me_as_well@127.0.0.1:6379/0

# Agent (agent/server.py). The classifier runs on its own model, so routing never spends
# the main model's per-minute token budget.
# GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b
# GROQ_TPM_LIMIT=8000
# AGENT_CHECKPOINTS=.agent_state/checkpoints.sqlite
