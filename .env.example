# Copy to .env and fill in. .env is gitignored; this file is checked in.

# API on the host -> Dockerised MySQL (compose publishes container 3306 on host 3307).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=card_analytics
MYSQL_POOL_SIZE=5

# API as a container in the same compose project:
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# NL -> DSL translator on Groq (https://console.groq.com/keys). Leave the key empty to
# run without it: questions then return 503, and DSL can still be sent directly.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
